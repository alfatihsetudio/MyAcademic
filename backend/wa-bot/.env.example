# MyAcademic WhatsApp Bot Configuration
# Salin file ini menjadi .env di dalam folder wa-bot

# URL Backend API Laravel MyAcademic
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# API Key Google Gemini (opsional jika backend sudah menangani atau untuk pemrosesan lokal)
GEMINI_API_KEY=

# Nomor WA Bot (hanya untuk referensi/tampilan)
BOT_PHONE_NUMBER=
